---
import SectionHeading from "./SectionHeading.astro";
import Icons from "./Icons.astro";
import type { Locale } from "../i18n/ui";
import { useTranslations, pick } from "../i18n/utils";

interface LocalizedText {
  en: string;
  id: string;
}
interface CertEntry {
  name: LocalizedText;
  issuer: LocalizedText;
  date: string;
  credentialUrl?: string;
}

interface Props {
  locale: Locale;
  entries: CertEntry[];
}

const { locale, entries } = Astro.props;
const t = useTranslations(locale);
const newTab = t("a11y.opensNewTab");
---

<section id="certifications" class="section">
  <div class="container-content">
    <SectionHeading title={t("section.certifications")} />
    <div class="grid gap-4 sm:grid-cols-2">
      {
        entries.map((entry) => (
          <article
            class="flex items-start justify-between gap-4 rounded-xl border border-border bg-white p-5"
            data-reveal
          >
            <div>
              <h3 class="font-semibold text-ink">{pick(entry.name, locale)}</h3>
              <p class="mt-1 text-sm text-body">{pick(entry.issuer, locale)}</p>
              <p class="mt-1 text-xs text-body/70">{entry.date}</p>
              {entry.credentialUrl && (
                <a
                  href={entry.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-teal mt-2"
                  aria-label={`${t("certifications.verify")} (${newTab})`}
                >
                  <Icons name="external" class="h-4 w-4" />
                  {t("certifications.verify")}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
