---
import SectionHeading from "./SectionHeading.astro";
import type { Locale } from "../i18n/ui";
import { useTranslations, pick, formatDateRange } from "../i18n/utils";

interface LocalizedText {
  en: string;
  id: string;
}
interface LocalizedArray {
  en: string[];
  id: string[];
}
interface ExpEntry {
  title: LocalizedText;
  organization: LocalizedText;
  startDate: string;
  endDate?: string;
  bullets: LocalizedArray;
}

interface Props {
  locale: Locale;
  entries: ExpEntry[];
}

const { locale, entries } = Astro.props;
const t = useTranslations(locale);
const present = t("experience.present");
---

<section id="experience" class="section">
  <div class="container-content">
    <SectionHeading title={t("section.experience")} />
    <div class="space-y-8 border-l border-border pl-6">
      {
        entries.map((entry) => (
          <article class="relative" data-reveal>
            <span
              class="absolute -left-[1.9rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-teal"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold text-ink">
                {pick(entry.title, locale)}
              </h3>
              <span class="text-sm font-medium text-teal">
                {formatDateRange(entry.startDate, entry.endDate, present)}
              </span>
            </div>
            <p class="mt-1 text-body">{pick(entry.organization, locale)}</p>
            <ul class="mt-3 list-outside list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-body">
              {pick(entry.bullets, locale)?.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
