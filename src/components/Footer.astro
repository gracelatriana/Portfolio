---
import Icons from "./Icons.astro";
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  locale: Locale;
  name: string;
  linkedin: string;
  github: string;
  year: number;
}

const { locale, name, linkedin, github, year } = Astro.props;
const t = useTranslations(locale);
const newTab = t("a11y.opensNewTab");
---

<footer class="border-t border-border bg-surface">
  <div
    class="container-content flex flex-col items-center justify-between gap-4 py-8 sm:flex-row"
  >
    <p class="text-sm text-body">
      &copy; {year} {name}. {t("footer.rights")}
    </p>
    <div class="flex items-center gap-4">
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-body transition-colors hover:text-navy"
        aria-label={`LinkedIn (${newTab})`}
      >
        <Icons name="linkedin" class="h-5 w-5" />
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-body transition-colors hover:text-navy"
        aria-label={`GitHub (${newTab})`}
      >
        <Icons name="github" class="h-5 w-5" />
      </a>
    </div>
    <p class="text-xs text-body/70">{t("footer.builtWith")}</p>
  </div>
</footer>
