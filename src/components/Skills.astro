---
import SectionHeading from "./SectionHeading.astro";
import type { Locale } from "../i18n/ui";
import { useTranslations, pick } from "../i18n/utils";

interface LocalizedText {
  en: string;
  id: string;
}
interface SkillGroup {
  category: LocalizedText;
  items: string[];
}

interface Props {
  locale: Locale;
  groups: SkillGroup[];
}

const { locale, groups } = Astro.props;
const t = useTranslations(locale);
---

<section id="skills" class="section bg-surface">
  <div class="container-content">
    <SectionHeading title={t("section.skills")} />
    <div class="grid gap-6 sm:grid-cols-2">
      {
        groups.map((group) => (
          <div
            class="rounded-xl border border-border bg-white p-6"
            data-reveal
          >
            <h3 class="text-sm font-semibold uppercase tracking-wide text-teal">
              {pick(group.category, locale)}
            </h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="tag-chip">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
