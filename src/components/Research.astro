---
import SectionHeading from "./SectionHeading.astro";
import Icons from "./Icons.astro";
import type { Locale } from "../i18n/ui";
import { useTranslations, pick, formatDateRange } from "../i18n/utils";

interface LocalizedText {
  en: string;
  id: string;
}
interface ResearchEntry {
  title: LocalizedText;
  venue: LocalizedText;
  date: string;
  summary: LocalizedText;
  link?: string;
}

interface Props {
  locale: Locale;
  entries: ResearchEntry[];
}

const { locale, entries } = Astro.props;
const t = useTranslations(locale);
const newTab = t("a11y.opensNewTab");
---

<section id="research" class="section">
  <div class="container-content">
    <SectionHeading title={t("section.research")} />
    <div class="space-y-6">
      {
        entries.map((entry) => (
          <article
            class="rounded-xl border border-border bg-white p-6"
            data-reveal
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold text-ink">
                {pick(entry.title, locale)}
              </h3>
              <span class="text-sm font-medium text-teal">{entry.date}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-body">
              {pick(entry.venue, locale)}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-body">
              {pick(entry.summary, locale)}
            </p>
            {entry.link && (
              <a
                href={entry.link}
                target="_blank"
                rel="noopener noreferrer"
                class="link-teal mt-4"
                aria-label={`${t("research.readMore")} (${newTab})`}
              >
                <Icons name="external" class="h-4 w-4" />
                {t("research.readMore")}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
